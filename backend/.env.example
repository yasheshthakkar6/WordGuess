# Copy this file to .env and fill in real values.
# Generate a random secret with:  python -c "import secrets; print(secrets.token_hex(32))"

JWT_SECRET_KEY=replace_with_a_random_hex_string
SESSION_SECRET_KEY=replace_with_a_different_random_hex_string

# Deployed frontend URL(s), comma-separated, for CORS in production.
# Leave unset for local dev -- localhost is always allowed.
# FRONTEND_URL=https://your-app.vercel.app
